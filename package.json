{
  "name": "tower-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A shared skyline grown out of a team's agent threads — fork of bot-crossing, synced through git instead of a server.",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "coding-agent",
    "three.js",
    "webgl",
    "colony-sim",
    "developer-tools",
    "visualization"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "dev": "npm run assets --silent && vite",
    "build": "npm run assets --silent && vite build",
    "start": "vite build && node --env-file-if-exists=.env server/serve.mjs",
    "serve": "node --env-file-if-exists=.env server/serve.mjs",
    "assets": "node tools/build-assets.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "vite": "^7.1.0"
  }
}
